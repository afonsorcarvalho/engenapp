<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conteúdo da home como DADO do módulo (deployável). noupdate=1: após a
         instalação, edições no Website Builder vencem; o -u não sobrescreve.
         Snippets nativos Odoo (editáveis no builder). Imagens via /web/image
         com id dinâmico do registro afr.labquali.homepage (robusto entre bases). -->
    <data noupdate="1">
    <template id="labquali_homepage" inherit_id="website.homepage" name="LabQuali Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <t t-set="lq_imgs" t-value="env['afr.labquali.homepage'].sudo().search([], limit=1)"/>
                <section class="s_banner o_animate o_anim_fade_in pt96 pb96" data-snippet="s_banner" data-name="Banner">
                    <div class="container">
                        <span class="lq-badge">✓ ISO 17025 · RDC 665/2022 · NR13</span>
                        <h1>Qualificação e Calibração de <span class="lq-accent">Equipamentos</span> de Esterilização</h1>
                        <p class="lead">Laudos técnicos com rastreabilidade metrológica para autoclaves, estufas, câmaras de estabilidade e inspeções NR13.</p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="/contactus" class="btn btn-lg lq-cta">Solicitar Orçamento</a>
                            <a href="/our-services" class="btn btn-lg lq-cta-ghost">Ver Serviços</a>
                        </div>
                    </div>
                </section>
                <section class="s_numbers o_animate o_anim_fade_in pt48 pb64" data-snippet="s_numbers" data-name="Números" style="background: linear-gradient(135deg,#071e32 0%,#0A3D62 100%);">
                    <div class="container">
                        <div class="row text-center align-items-center">
                        <div class="col-md-4 col-6">
                            <div class="s_number">
                                <h2 class="s_number_bignumber">+500</h2>
                                <h3>Equipamentos/ano</h3>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="s_number">
                                <h2 class="s_number_bignumber">15+</h2>
                                <h3>Anos de experiência</h3>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="s_number">
                                <h2 class="s_number_bignumber">100%</h2>
                                <h3>Laudos rastreáveis</h3>
                            </div>
                        </div>
                        </div>
                    </div>
                </section>
                <section class="s_three_columns o_animate o_anim_fade_in pt96 pb64" data-vcss="001" data-snippet="s_three_columns" data-name="Serviços">
                    <div class="container">
                        <div class="text-center mb-4"><h2>Nossos <span style="color:var(--lq-accent)">Serviços</span></h2></div>
                        <div class="row d-flex align-items-stretch">
                        <div class="col-lg-3 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/svc_qualificacao' % lq_imgs.id" alt="Qualificação QI/QO/QD" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Qualificação QI/QO/QD</h3>
                                    <p class="card-text">Qualificação de instalação, operação e desempenho conforme RDC 665/2022 e boas práticas de fabricação.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/svc_calibracao' % lq_imgs.id" alt="Calibração de Sensores" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Calibração de Sensores</h3>
                                    <p class="card-text">Termopares, termômetros, manômetros e sensores de pressão com rastreabilidade metrológica RBC/Inmetro.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/svc_nr13' % lq_imgs.id" alt="Inspeção NR13" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Inspeção NR13</h3>
                                    <p class="card-text">Vasos de pressão, caldeiras e autoclaves conforme NR13 do MTE. Relatórios para fiscalização.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/svc_mapeamento' % lq_imgs.id" alt="Mapeamento Térmico" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Mapeamento Térmico</h3>
                                    <p class="card-text">Mapeamento de temperatura em câmaras, estufas e geladeiras com malha de pontos e análise estatística.</p>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </section>
                <section class="s_three_columns o_animate o_anim_fade_in pt64 pb64" data-vcss="001" data-snippet="s_three_columns" data-name="Diferenciais">
                    <div class="container">
                        <div class="text-center mb-4"><h2>Confiança técnica em <span style="color:var(--lq-accent)">cada laudo</span></h2></div>
                        <div class="row d-flex align-items-stretch">
                        <div class="col-lg-4 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/dif_rastreabilidade' % lq_imgs.id" alt="Rastreabilidade Metrológica" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Rastreabilidade Metrológica</h3>
                                    <p class="card-text">Padrões calibrados em laboratórios acreditados pela RBC. Cadeia ininterrupta até o BIPM.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/dif_laudos' % lq_imgs.id" alt="Laudos em até 5 dias úteis" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Laudos em até 5 dias úteis</h3>
                                    <p class="card-text">Sistema digital de geração de relatórios com assinatura eletrônica e acesso imediato.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/dif_equipe' % lq_imgs.id" alt="Equipe Especializada" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Equipe Especializada</h3>
                                    <p class="card-text">Engenheiros e técnicos com formação em metrologia, farmácia industrial e engenharia hospitalar.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/dif_portal' % lq_imgs.id" alt="Portal do Cliente" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Portal do Cliente</h3>
                                    <p class="card-text">Acesse laudos, histórico de qualificações e certificados a qualquer momento, de qualquer dispositivo.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/dif_nacional' % lq_imgs.id" alt="Atendimento Nacional" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Atendimento Nacional</h3>
                                    <p class="card-text">Presença em todo o Brasil. Equipes locais nas principais capitais para atendimento ágil.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/dif_conformidade' % lq_imgs.id" alt="Conformidade Regulatória" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Conformidade Regulatória</h3>
                                    <p class="card-text">Laudos alinhados à ANVISA (RDC 665/2022), MTE (NR13) e normas ABNT aplicáveis.</p>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </section>
                <section class="s_three_columns o_animate o_anim_fade_in pt64 pb96" data-vcss="001" data-snippet="s_three_columns" data-name="Equipamentos" style="background:var(--lq-fog);">
                    <div class="container">
                        <div class="text-center mb-4"><h2>Expertise em equipamentos <span style="color:var(--lq-accent)">críticos</span></h2></div>
                        <div class="row d-flex align-items-stretch justify-content-center">
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_autoclave' % lq_imgs.id" alt="Autoclaves a Vapor" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Autoclaves a Vapor</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_estufa' % lq_imgs.id" alt="Estufas de Esterilização" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Estufas de Esterilização</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_camara_estab' % lq_imgs.id" alt="Câmaras de Estabilidade" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Câmaras de Estabilidade</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_camara_fria' % lq_imgs.id" alt="Câmaras Frias" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Câmaras Frias</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_incubadora' % lq_imgs.id" alt="Incubadoras" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Incubadoras</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_geladeira' % lq_imgs.id" alt="Geladeiras Farmacêuticas" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Geladeiras Farmacêuticas</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_vaso_pressao' % lq_imgs.id" alt="Vasos de Pressão" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Vasos de Pressão</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_caldeira' % lq_imgs.id" alt="Caldeiras" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Caldeiras</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_liofilizador' % lq_imgs.id" alt="Liofilizadores" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Liofilizadores</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_tunel_calor' % lq_imgs.id" alt="Túneis de Calor" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Túneis de Calor</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_lavadora' % lq_imgs.id" alt="Lavadoras Ultrassônicas" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Lavadoras Ultrassônicas</h3>
                                    
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4 pt16 pb16">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top" t-att-src="'/web/image/afr.labquali.homepage/%s/eqp_termometro' % lq_imgs.id" alt="Termômetros e Sondas" loading="lazy"/>
                                <div class="card-body">
                                    <h3 class="card-title">Termômetros e Sondas</h3>
                                    
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </section>
                <section class="s_numbers o_animate o_anim_fade_in pt64 pb64" data-snippet="s_numbers" data-name="Prova" style="background: linear-gradient(135deg,#071e32 0%,#0A3D62 100%);">
                    <div class="container">
                        <div class="row text-center align-items-center">
                        <div class="col-md-4 col-6">
                            <div class="s_number">
                                <h2 class="s_number_bignumber">120+</h2>
                                <h3>Instituições atendidas</h3>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="s_number">
                                <h2 class="s_number_bignumber">12</h2>
                                <h3>Estados com atendimento</h3>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="s_number">
                                <h2 class="s_number_bignumber">5000+</h2>
                                <h3>Qualificações realizadas</h3>
                            </div>
                        </div>
                        </div>
                    <div class="lq-segments"><span>Hospitais</span><span>Farmácias</span><span>Indústrias</span><span>Laboratórios</span></div>
                    </div>
                </section>
                <section class="s_call_to_action o_animate o_anim_fade_in pt96 pb96" data-snippet="s_call_to_action" data-name="Chamada">

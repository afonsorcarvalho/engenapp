<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Re-gateia os menus de topo desnecessários para exigir "Menu Completo".
         Operadores não têm esse grupo => menus ocultos.
         Admins têm (via implied_ids) => continuam vendo tudo.

         groups_id ORIGINAIS (para restaurar caso desinstale; o uninstall NÃO
         reverte automaticamente):
           Discuss    (mail.menu_root_discuss)                         = [1]
           Calendar   (calendar.mail_menu_calendar)                    = [1]
           Dashboards (spreadsheet_dashboard.spreadsheet_dashboard_menu_root) = []
           Website    (website.menu_website_configuration)             = [1]
           Apps       (base.menu_management)                           = []
           Inventory  (stock.menu_stock_root)                          = [25, 24]
    -->

    <!-- Discuss -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_labquali_full_menu')])]"/>
    </record>

    <!-- Calendar -->
    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_labquali_full_menu')])]"/>
    </record>

    <!-- Dashboards (spreadsheet) -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_labquali_full_menu')])]"/>
    </record>

    <!-- Website -->
    <record id="website.menu_website_configuration" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_labquali_full_menu')])]"/>
    </record>

    <!-- Apps -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_labquali_full_menu')])]"/>
    </record>

    <!-- Inventory -->
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_labquali_full_menu')])]"/>
    </record>

    <!-- Ordem dos menus visíveis ao Operador (sequence global; seguro pois
         só há admin + operadores). Ordem pedida:
         Contatos, Vendas, Faturamento, Qualificações, Funcionários, Eng. Clínica -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="sequence">30</field>
    </record>
    <record id="afr_qualificacao.menu_afr_qualificacao_root" model="ir.ui.menu">
        <field name="sequence">40</field>
    </record>
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="sequence">50</field>
    </record>
    <record id="engc_os.menu_root" model="ir.ui.menu">
        <field name="sequence">60</field>
    </record>

</odoo>

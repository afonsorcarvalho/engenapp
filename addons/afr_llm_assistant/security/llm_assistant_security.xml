<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_afr_llm_chat_session_own" model="ir.rule">
        <field name="name">Assistente LLM: sessões apenas do próprio usuário</field>
        <field name="model_id" ref="model_afr_llm_chat_session"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_afr_llm_chat_message_own" model="ir.rule">
        <field name="name">Assistente LLM: mensagens apenas das sessões do usuário</field>
        <field name="model_id" ref="model_afr_llm_chat_message"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_afr_llm_chat_job_own" model="ir.rule">
        <field name="name">Assistente LLM: jobs apenas das sessões do próprio usuário</field>
        <field name="model_id" ref="model_afr_llm_chat_job"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>

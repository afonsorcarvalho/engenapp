<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View do Wizard -->
    <record id="view_wizard_ler_diretorio_ciclos_form" model="ir.ui.view">
        <field name="name">wizard.ler.diretorio.ciclos.form</field>
        <field name="model">wizard.ler.diretorio.ciclos</field>
        <field name="arch" type="xml">
            <form string="Configurar Leitura de Diretório">
                <group>
                    <group string="Período de Leitura">
                        <field name="data_inicio" widget="date"/>
                        <field name="data_fim" widget="date"/>
                        <field name="info_range" readonly="1"/>
                    </group>
                    <group string="Filtros Opcionais">
                        <field name="equipment_id" 
                               domain="[('cycle_type_id', '!=', False)]"
                               placeholder="Selecione um equipamento (opcional)"
                               context="{'show_apelido_first': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirmar_leitura" 
                            string="Executar Leitura" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_cancelar" 
                            string="Cancelar" 
                            type="object" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action para abrir o wizard -->
    <record id="action_wizard_ler_diretorio_ciclos" model="ir.actions.act_window">
        <field name="name">Configurar Leitura de Diretório</field>
        <field name="res_model">wizard.ler.diretorio.ciclos</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Action para abrir o wizard da tree view -->
    <record id="action_wizard_ler_diretorio_ciclos_tree" model="ir.actions.act_window">
        <field name="name">Ler Diretório de Ciclos</field>
        <field name="res_model">wizard.ler.diretorio.ciclos</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Item (opcional, para acesso direto) -->
    <!-- 
    <menuitem id="menu_wizard_ler_diretorio_ciclos"
              name="Leitura de Diretório"
              parent="menu_afr_supervisorio_ciclos"
              action="action_wizard_ler_diretorio_ciclos"
              sequence="10"/>
    -->

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ciclos_template">

        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
            <style>
                .legenda {
                    font-size: 9px;
                }
                .titulo_grafico {
                    margin:0px;
                }
                .table-sm th, .table-sm td {
                    padding: 0.3rem;
                    font-size: 12px;
                }
          
                
                /* Estilos para a tabela de estatísticas */
                .table-statistics {
                    font-size: 11px;
                }
                
             
            </style>
                
                    <div class="page">

                        <h2 class="text-center">RELATÓRIO DE CICLO</h2>
                        <h3 class="text-center"><span t-field="o.name" /></h3>
                        <h3>Cod. Carga <span t-field="o.batch_number" /></h3>
                        <div class="row" name='equipamento'>
                            <div class="col-2">
                                <strong>Equipamento: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.equipment_id" />
                            </div>
                            <div class="col-2">
                                <strong>Apelido: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.equipment_nickname" />
                            </div>
                        </div>
                        <div class="row" name='ciclo'>
                            <div class="col-2">
                                <strong>Duração (HH:mm): </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.duration"  t-options='{"widget": "float_time"}'/>
                            </div>
                       
                            <div class="col-2">
                                <strong>Ciclo selecionado: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.cycle_features_id" />
                            </div>
                        </div>
                        <div class="row" name='data_ciclo'>
                            <div class="col-2">
                                <strong>Data início: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.start_date" />
                            </div>
                            <div class="col-2">
                                <strong>Data fim: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.end_date" />
                            </div>
                            

                        </div>
                        
                     
                        <div class="row" name='status'>
                            <div class="col-2">
                                <strong>Status: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.state" />
                            </div>
                     
                        </div>
                        
                        <!-- Seção de Indicador Biológico -->
                        <div class="row mt-4" t-if="o.ib_lote">
                            <div class="col-12">
                                <h5 class="mb-3">Indicador Biológico</h5>
                            </div>
                        </div>
                        <div class="row" t-if="o.ib_lote">
                            <div class="col-2">
                                <strong>Lote IB: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.ib_lote" />
                            </div>
                            <div class="col-2">
                                <strong>Marca: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.ib_marca" />
                            </div>
                        </div>
                        <div class="row" t-if="o.ib_lote">
                            <div class="col-2">
                                <strong>Modelo: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.ib_modelo" />
                            </div>
                            <div class="col-2">
                                <strong>Resultado: </strong>
                            </div>
                            <div class="col-4">
                                <t t-esc="o.ib_resultado"/>        
                            </div>
                        </div>
                        <div class="row" t-if="o.ib_lote">
                            <div class="col-2">
                                <strong>Início Incubação: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.ib_data_inicio" />
                            </div>
                            <div class="col-2">
                                <strong>Fim Incubação: </strong>
                            </div>
                            <div class="col-4">
                                <span t-field="o.ib_data_fim" />
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                             
                                <div class="row mt-2">
                                    <div class="col-12" t-if="o.notes">
                                        <strong>Observações: </strong>
                                        <div t-field="o.notes" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Tabela de Estatísticas do Ciclo -->
                        <t t-set="cycle_stats" t-value="o.get_cycle_statistics_for_report()"/>
                        <!-- debug -->
                        <!-- <div>rows: <t t-esc="cycle_stats and cycle_stats.get('rows') and len(cycle_stats.get('rows'))"/> | vars: <t t-esc="cycle_stats and cycle_stats.get('variables') and len(cycle_stats.get('variables'))"/></div> -->
                        
                        <div class="row mt-3 mb-3" t-if="cycle_stats and cycle_stats.get('rows') and len(cycle_stats.get('rows')) > 0">
                            <div class="col-12">
                                <h5 class="text-center mb-3">Estatísticas do Ciclo</h5>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm table-statistics">
                                        <thead>
                                            <tr>
                                                <th rowspan="2">Fase</th>
                                                <th rowspan="2">Duração(mm:ss)</th>
                                                <t t-foreach="cycle_stats.get('variables')" t-as="v">
                                                    <th class="text-center" t-att-colspan="3"><t t-esc="v"/></th>
                                                </t>
                                            </tr>
                                            <tr>
                                                <t t-foreach="cycle_stats.get('variables')" t-as="v">
                                                    <th class="text-center">min</th>
                                                    <th class="text-center">max</th>
                                                    <th class="text-center">media</th>
                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="cycle_stats.get('rows')" t-as="r">
                                                <tr>
                                                    <td t-esc="r.get('fase')"/>
                                                    <td class="text-center" t-esc="(r.get('duracao') if r.get('duracao') else '-')"/>
                                                    <t t-foreach="cycle_stats.get('variables')" t-as="v">
                                                        <t t-set="m" t-value="r.get('metrics').get(v) if r.get('metrics') else {}"/>
                                                        <td class="text-end" t-esc="(('%.2f' % m.get('min')) if (m is not None and m.get('min') is not None) else '-')"/>
                                                        <td class="text-end" t-esc="(('%.2f' % m.get('max')) if (m is not None and m.get('max') is not None) else '-')"/>
                                                        <td class="text-end" t-esc="(('%.2f' % m.get('media')) if (m is not None and m.get('media') is not None) else '-')"/>
                                                    </t>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Mensagem quando não há estatísticas -->
                        <div class="row mt-3 mb-3" t-if="not cycle_stats or not cycle_stats.get('rows') or len(cycle_stats.get('rows')) == 0">
                            <div class="col-12">
                                <div class="alert alert-info text-center">
                                    <em>Nenhuma estatística disponível para este ciclo.</em>
                                </div>
                            </div>
                        </div>
                       
                        <div class="row mt-3 mb-1">
                           <div class="col-12 text-center"  >
                            <h5 class="titulo_grafico">Gráfico do Ciclo</h5>
                            <t t-if="o.cycle_graph">
                                <img class="mr-5" t-attf-src="data:image/png;charset=utf-8;base64,{{o.cycle_graph}}" width="100%"/>
                            </t>
                            <t t-else="">
                                <p>Nenhum gráfico disponível para este ciclo.</p>
                            </t>
                           </div>
                        </div>
                       
                        <div class="row mt-5">
                            <div class="col-6  text-left" >
                            <t t-if="o.notes">
                            
                               * Observações: 
                                 <span t-field="o.notes" /><br/> 
                            </t>  
                            </div>
                            <div class="col-6 text-center">
                                <t t-if="o.is_signed">
                                    <div t-if="o.signature_image" class="mb-2">
                                        <img t-attf-src="data:image/png;base64,{{o.signature_image}}"
                                             style="max-height:100px;max-width:100%;" alt="Assinatura"/>
                                    </div>
                                    <div class="mt-2 mb-2">
                                        Garantia de qualidade / Aprovação
                                    </div>
                                    <div  style="display:inline-block;max-width:100%;text-align:center;font-size:8px;">
                                        <strong><span t-field="o.signature_employee_name"/></strong><br/>
                                        <t t-if="o.signature_professional_documentation">
                                            <span t-field="o.signature_professional_documentation"/><br/>
                                        </t>
                                        <t t-if="o.signature_professional_council or o.signature_professional_council_number">
                                            <span t-field="o.signature_professional_council"/>
                                            <t t-if="o.signature_professional_council_number">
                                                <t t-if="o.signature_professional_council"> — </t>
                                                <span t-field="o.signature_professional_council_number"/>
                                            </t>
                                            <br/>
                                        </t>
                                        <t t-if="o.signature_professional_cpf and not o.signature_professional_council_number">
                                            CPF: <span t-field="o.signature_professional_cpf"/><br/>
                                        </t>
                                        <t t-if="o.signature_date">
                                          Assinatura eletrônica em  <span t-field="o.signature_date"/>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="not o.is_signed">
                                    ________________________________________<br/>
                                    Garantia de qualidade<br/>
                                    Aprovação
                                </t>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Seção de Anexo: Fotos do Ciclo (cada foto em uma página separada) -->
                    <t t-if="o.fotos_ids">
                        <t t-foreach="o.fotos_ids" t-as="foto">
                            <div style="page-break-before: always;">
                                <div class="row mt-4">
                                    <div class="col-12 text-center">
                                        <h4 class="mb-4"><span t-field="foto.titulo"/></h4>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-12">
                                        <table class="table table-sm table-bordered">
                                           
                                            <tr t-if="foto.legenda">
                                                <td class="font-weight-bold bg-light">Legenda:</td>
                                                <td><span t-field="foto.legenda"/></td>
                                            </tr>
                                            <tr>
                                                <td class="font-weight-bold bg-light">Data:</td>
                                                <td><span t-field="foto.data_criacao"/></td>
                                            </tr>
                                            
                                        </table>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12 text-center">
                                        <img t-if="foto.imagem" t-attf-src="data:image/png;base64,{{foto.imagem}}" 
                                             style="max-width: 100%; max-height: 800px; border: 1px solid #ddd; padding: 10px; background: white;"
                                             t-att-alt="foto.titulo"/>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-12 text-center text-muted">
                                        <small>
                                            Foto <span t-esc="foto_index + 1"/> de <span t-esc="len(o.fotos_ids)"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                    
                </t>
            </t>
        </t>
    </template>

</odoo>

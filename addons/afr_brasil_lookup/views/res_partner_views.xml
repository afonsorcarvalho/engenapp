<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_brl_lookup" model="ir.ui.view">
        <field name="name">res.partner.form.brl.lookup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Botão "Buscar CEP" ao lado do campo zip -->
            <xpath expr="//field[@name='zip']" position="after">
                <button name="action_brl_lookup_cep"
                        type="object"
                        class="btn-link oe_inline fa fa-search"
                        title="Buscar CEP"
                        attrs="{'invisible': [('zip', 'in', [False, ''])]}"
                        help="Buscar endereço por CEP (BrasilAPI)"/>
            </xpath>

            <!-- Botão "Buscar CNPJ" ao lado do campo vat -->
            <xpath expr="//field[@name='vat']" position="after">
                <button name="action_brl_lookup_cnpj"
                        type="object"
                        class="btn-link oe_inline fa fa-search"
                        title="Buscar CNPJ"
                        attrs="{'invisible': [('vat', 'in', [False, ''])]}"
                        help="Buscar dados de empresa por CNPJ (open.cnpja.com)"/>
            </xpath>

        </field>
    </record>

</odoo>

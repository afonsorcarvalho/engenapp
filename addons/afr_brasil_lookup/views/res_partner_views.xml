<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_brl_lookup" model="ir.ui.view">
        <field name="name">res.partner.form.brl.lookup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- 1. CNPJ (vat) movido para logo abaixo do nome, com lupa colada ao campo.
                 d-flex content-width mantem a lupa junto ao valor (o_row esticaria). -->
            <xpath expr="//field[@name='vat']" position="replace"/>

            <xpath expr="//h1" position="after">
                <label for="vat" string="CPF/CNPJ"/>
                <div class="d-flex align-items-center" style="gap:6px;">
                    <field name="vat" placeholder="00.000.000/0000-00" on_change="1"
                           style="flex:0 0 auto;width:auto;"
                           attrs="{'readonly': [('parent_id', '!=', False)]}"/>
                    <button name="action_brl_lookup_cnpj"
                            type="object"
                            icon="fa-search"
                            title="Buscar CNPJ"
                            class="btn btn-link p-0"
                            style="flex:0 0 auto;"
                            attrs="{'invisible': [('vat', 'in', [False, ''])]}"
                            help="Buscar dados de empresa por CNPJ (open.cnpja.com)"/>
                </div>
            </xpath>

            <!-- 2. Override do bloco de endereco com flexbox (layout determinístico,
                 independe das larguras % que variam entre leitura/edicao). O OWL
                 preserva <field> dentro de <div> (ao contrario de <span>), entao a
                 lupa CEP fica na mesma linha do zip, logo apos o campo. -->
            <xpath expr="//div[hasclass('o_address_format')]" position="replace">
                <div class="o_address_format">
                    <field name="street" placeholder="Endereço..." class="o_address_street"
                           attrs="{'readonly': [('type', '=', 'contact'), ('parent_id', '!=', False)]}"/>
                    <field name="street2" placeholder="Complemento..." class="o_address_street"
                           attrs="{'readonly': [('type', '=', 'contact'), ('parent_id', '!=', False)]}"/>
                    <div class="d-flex align-items-center" style="gap:8px;">
                        <field name="city" placeholder="Cidade" nolabel="1"
                               style="flex:2 1 0;min-width:0;"
                               attrs="{'readonly': [('type', '=', 'contact'), ('parent_id', '!=', False)]}"/>
                        <field name="state_id" placeholder="Estado" nolabel="1"
                               options="{'no_open': True, 'no_quick_create': True}"
                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"
                               on_change="1"
                               style="flex:2 1 0;min-width:0;"
                               attrs="{'readonly': [('type', '=', 'contact'), ('parent_id', '!=', False)]}"/>
                        <field name="zip" placeholder="CEP" nolabel="1" on_change="1"
                               style="flex:1 1 0;min-width:0;"
                               attrs="{'readonly': [('type', '=', 'contact'), ('parent_id', '!=', False)]}"/>
                        <button name="action_brl_lookup_cep"
                                type="object"
                                icon="fa-search"
                                title="Buscar CEP"
                                class="btn btn-link p-0"
                                style="flex:0 0 auto;"
                                attrs="{'invisible': [('zip', 'in', [False, ''])]}"
                                help="Buscar endereço por CEP (BrasilAPI)"/>
                    </div>
                    <div name="partner_address_country" class="d-flex justify-content-between">
                        <field name="country_id" placeholder="País" class="o_address_country"
                               options="{'no_open': True, 'no_create': True}" on_change="1"
                               attrs="{'readonly': [('type', '=', 'contact'), ('parent_id', '!=', False)]}"/>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>

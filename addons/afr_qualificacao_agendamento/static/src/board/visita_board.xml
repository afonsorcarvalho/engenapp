<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="afr_qualificacao_agendamento.VisitaBoard" owl="1">
        <div class="o_vb_board">
            <div class="o_vb_toolbar">
                <button class="btn btn-secondary" t-on-click="prevRange"><i class="fa fa-chevron-left"/></button>
                <button class="btn btn-secondary" t-on-click="today">Hoje</button>
                <button class="btn btn-secondary" t-on-click="nextRange"><i class="fa fa-chevron-right"/></button>
                <input type="date" class="o_vb_date" t-att-value="state.date_from"
                       t-on-change="onChangeFrom"/>
                <span class="o_vb_sep">até</span>
                <input type="date" class="o_vb_date" t-att-value="state.date_to"
                       t-on-change="onChangeTo"/>
            </div>
            <div class="o_vb_grid_wrap">
                <table class="o_vb_grid">
                    <thead>
                        <tr>
                            <th class="o_vb_corner">Técnico</th>
                            <th t-foreach="days" t-as="day" t-key="day"
                                t-att-class="day === todayDate ? 'o_vb_today' : ''">
                                <t t-esc="dayLabel(day)"/>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="!displayTechnicians.length">
                            <td t-att-colspan="days.length + 1" class="o_vb_empty">
                                Sem visitas no intervalo.
                            </td>
                        </tr>
                        <tr t-foreach="displayTechnicians" t-as="tec" t-key="tec.id">
                            <td class="o_vb_tec"><t t-esc="tec.name"/></td>
                            <td t-foreach="days" t-as="day" t-key="day"
                                t-att-class="'o_vb_cell' + (day === todayDate ? ' o_vb_today_cell' : '')"
                                t-on-dragover="onDragOver"
                                t-on-dragenter="onDragEnter"
                                t-on-dragleave="onDragLeave"
                                t-on-drop="(ev) => this.onDrop(ev, tec.id, day)">
                                <div t-foreach="cellVisitas(tec.id, day)" t-as="v" t-key="v.id"
                                     class="o_vb_bar"
                                     t-att-class="colorClass(v.os_id) + (v.conflict ? ' o_vb_conflict' : '') + (v.state === 'done' ? ' o_vb_done' : '') + (v.overflow ? ' o_vb_has_split' : '')"
                                     t-att-draggable="v.state !== 'done' ? 'true' : 'false'"
                                     t-on-dragstart="(ev) => this.onDragStart(ev, v.id)"
                                     t-on-click="() => this.openVisita(v.id)"
                                     t-att-title="barTitle(v)">
                                    <div class="o_vb_bar_content">
                                        <!-- Linha 1: OS name + done badge + horas badge + lixeira -->
                                        <div class="o_vb_bar_row">
                                            <span class="o_vb_bar_os">
                                                <t t-esc="v.os_name"/>
                                                <t t-if="v.state === 'done'">
                                                    <span class="o_vb_done_badge"><i class="fa fa-check"/></span>
                                                </t>
                                            </span>
                                            <span t-if="v.planned_hours" class="o_vb_hours">
                                                <t t-esc="v.planned_hours"/>h
                                            </span>
                                            <button class="o_vb_trash_btn" title="Apagar visita"
                                                    t-on-click="(ev) => this.onDeleteVisita(ev, v.id)"><i class="fa fa-trash-o"/></button>
                                        </div>
                                        <!-- Horário início–fim (editável) -->
                                        <div class="o_vb_bar_hours_edit">
                                            <input type="time" class="o_vb_time_in"
                                                   t-att-value="hhmm(v.time_start)"
                                                   draggable="false"
                                                   t-on-click="(ev) => this.stopBar(ev)"
                                                   t-on-change="(ev) => this.onSetHour(ev, v.id, 'start', v.time_start, v.time_stop)"/>
                                            <span>–</span>
                                            <input type="time" class="o_vb_time_in"
                                                   t-att-value="hhmm(v.time_stop)"
                                                   draggable="false"
                                                   t-on-click="(ev) => this.stopBar(ev)"
                                                   t-on-change="(ev) => this.onSetHour(ev, v.id, 'stop', v.time_start, v.time_stop)"/>
                                        </div>
                                        <!-- partner -->
                                        <span class="o_vb_bar_partner" t-esc="v.partner_name"/>
                                        <!-- equipamentos + instrumentos (um por linha) -->
                                        <div t-if="(v.equipment_list &amp;&amp; v.equipment_list.length) || (v.instrument_list &amp;&amp; v.instrument_list.length)"
                                             class="o_vb_bar_resources">
                                            <div t-foreach="v.equipment_list" t-as="eq" t-key="'eq' + eq_index"
                                                 class="o_vb_bar_res_line"><i class="fa fa-wrench"/> <t t-esc="eq"/></div>
                                            <div t-foreach="v.instrument_list" t-as="ins" t-key="'ins' + ins_index"
                                                 class="o_vb_bar_res_line"><i class="fa fa-tachometer"/> <t t-esc="ins"/></div>
                                        </div>
                                        <!-- mensagem de conflito -->
                                        <div t-if="v.conflict &amp;&amp; v.conflict_msg" class="o_vb_bar_conflict_msg">
                                            <i class="fa fa-exclamation-triangle"/> <t t-esc="v.conflict_msg"/>
                                        </div>
                                    </div>
                                    <!-- Faixa de divisão full-height quando passa do dia -->
                                    <button t-if="v.overflow" class="o_vb_split_strip"
                                            title="Passa do dia — dividir: criar visita-continuação no dia seguinte com o resto das horas"
                                            t-on-click="(ev) => this.onSplitOverflow(ev, v.id)"><i class="fa fa-plus"/></button>
                                </div>
                                <!-- Botão "+" para adicionar visita (visível on-hover) -->
                                <div class="o_vb_add_visita">
                                    <button class="o_vb_add_btn"
                                            t-on-click="(ev) => this.onAddVisitaClick(ev, tec.id, day)"><i class="fa fa-plus"/></button>
                                    <div t-if="state.openDropdown === ('os:' + tec.id + ':' + day)"
                                         class="o_vb_dropdown"
                                         t-att-style="dropdownStyle"
                                         t-on-click="(ev) => this.stopDropdownClick(ev)">
                                        <input type="text" class="o_vb_dropdown_search"
                                               placeholder="Filtrar por Nº QOS ou cliente..."
                                               t-att-value="state.osFilter"
                                               t-on-input="(ev) => this.onOsFilterInput(ev)"/>
                                        <div t-foreach="filteredOsOptions" t-as="os" t-key="os.id"
                                             class="o_vb_dropdown_item"
                                             t-on-click="() => this.addVisita(os.id, tec.id, day)">
                                            <t t-esc="os.name"/>
                                        </div>
                                        <div t-if="!filteredOsOptions.length" class="o_vb_dropdown_empty">
                                            Nenhuma OS encontrada.
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <!-- Linha-rodapé: adicionar técnico -->
                        <tr class="o_vb_footer_row">
                            <td class="o_vb_tec o_vb_add_tec_cell">
                                <button class="o_vb_add_btn"
                                        t-on-click="(ev) => this.onAddTecnicoClick(ev)"><i class="fa fa-plus"/> Técnico</button>
                                <div t-if="state.openDropdown === 'tecnico'"
                                     class="o_vb_dropdown"
                                     t-att-style="dropdownStyle"
                                     t-on-click="(ev) => this.stopDropdownClick(ev)">
                                    <div t-foreach="availableTecnicoOptions" t-as="tec" t-key="tec.id"
                                         class="o_vb_dropdown_item"
                                         t-on-click="() => this.addTecnico(tec)">
                                        <t t-esc="tec.name"/>
                                    </div>
                                    <div t-if="!availableTecnicoOptions.length" class="o_vb_dropdown_empty">
                                        Todos os técnicos já estão no quadro.
                                    </div>
                                </div>
                            </td>
                            <td t-att-colspan="days.length"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_is_tecnico" model="ir.ui.view">
        <field name="name">hr.employee.form.is.tecnico</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="is_tecnico"/>
                <!-- Cor do técnico na agenda do PWA (bolinhas). Campo `color`
                     já existe no core (hr.employee); só expomos aqui com o
                     seletor nativo. 0 = "sem cor" = cor automática derivada
                     do id (comportamento atual, sem configuração). -->
                <field name="color" widget="color_picker"/>
            </xpath>
        </field>
    </record>
</odoo>

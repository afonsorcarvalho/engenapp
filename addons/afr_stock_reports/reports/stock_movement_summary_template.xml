<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_stock_movement_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page">
                    <h3 class="text-center mt-2 mb-1">Sumário de Movimentações de Estoque</h3>
                    <p class="text-center text-muted mb-3">
                        <t t-esc="filters.get('company_name')"/>
                    </p>

                    <div class="bg-light p-2 rounded mb-3" style="font-size: 10px;">
                        <strong>Período:</strong>
                        <span t-esc="filters.get('date_from')" t-options='{"widget": "date"}'/>
                        a
                        <span t-esc="filters.get('date_to')" t-options='{"widget": "date"}'/>
                        &amp;nbsp;|&amp;nbsp;
                        <strong>Tipo:</strong> <t t-esc="filters.get('movement_type')"/>
                        &amp;nbsp;|&amp;nbsp;
                        <strong>Location:</strong> <t t-esc="filters.get('location_usage')"/>
                        <t t-if="filters.get('include_draft')">
                            &amp;nbsp;|&amp;nbsp;
                            <strong>(inclui não confirmados)</strong>
                        </t>
                        <br/>
                        <strong>Armazém:</strong>
                        <t t-esc="filters.get('warehouse_name') or 'Todos'"/>
                        <t t-if="filters.get('location_names')">
                            &amp;nbsp;|&amp;nbsp;
                            <strong>Locations:</strong> <t t-esc="filters.get('location_names')"/>
                        </t>
                        <br/>
                        <strong>Categorias:</strong> <t t-esc="filters.get('category_names')"/>
                    </div>

                    <t t-set="show_entrada" t-value="filters.get('movement_type_raw') in ('entrada', 'ambos')"/>
                    <t t-set="show_saida" t-value="filters.get('movement_type_raw') in ('saida', 'ambos')"/>
                    <t t-set="show_saldo" t-value="filters.get('movement_type_raw') == 'ambos'"/>

                    <t t-if="not groups">
                        <div class="alert alert-warning text-center">
                            <strong>Nenhuma movimentação encontrada</strong> para os filtros selecionados.
                        </div>
                    </t>

                    <t t-if="groups">
                        <table class="table table-bordered table-sm" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th style="width:8%">Código</th>
                                    <th>Produto</th>
                                    <th style="width:7%">UoM</th>
                                    <th t-if="show_entrada" style="width:9%" class="text-right">Qtd Entrada</th>
                                    <th t-if="show_saida" style="width:9%" class="text-right">Qtd Saída</th>
                                    <th t-if="show_saldo" style="width:9%" class="text-right">Saldo</th>
                                    <th style="width:9%" class="text-right">Custo Unit.</th>
                                    <th t-if="show_entrada" style="width:11%" class="text-right">Custo Entrada</th>
                                    <th t-if="show_saida" style="width:11%" class="text-right">Custo Saída</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="groups" t-as="grp">
                                    <tr class="table-active">
                                        <td colspan="999">
                                            <strong><t t-esc="grp['category']"/></strong>
                                            <span class="text-muted">
                                                (<t t-esc="len(grp['lines'])"/> produtos)
                                            </span>
                                        </td>
                                    </tr>
                                    <t t-foreach="grp['lines']" t-as="line">
                                        <tr>
                                            <td><t t-esc="line['default_code']"/></td>
                                            <td><t t-esc="line['name']"/></td>
                                            <td><t t-esc="line['uom']"/></td>
                                            <td t-if="show_entrada" class="text-right">
                                                <t t-esc="'%.3f' % line['entrada_qty']"/>
                                            </td>
                                            <td t-if="show_saida" class="text-right">
                                                <t t-esc="'%.3f' % line['saida_qty']"/>
                                            </td>
                                            <td t-if="show_saldo" class="text-right">
                                                <t t-esc="'%.3f' % line['saldo']"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="line['cost_unit']"
                                                      t-options='{"widget": "monetary", "display_currency": filters["company_currency"]}'/>
                                            </td>
                                            <td t-if="show_entrada" class="text-right">
                                                <span t-esc="line['cost_entrada']"
                                                      t-options='{"widget": "monetary", "display_currency": filters["company_currency"]}'/>
                                            </td>
                                            <td t-if="show_saida" class="text-right">
                                                <span t-esc="line['cost_saida']"
                                                      t-options='{"widget": "monetary", "display_currency": filters["company_currency"]}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="table-light font-italic">
                                        <td colspan="3" class="text-right"><strong>Subtotal <t t-esc="grp['category']"/>:</strong></td>
                                        <td t-if="show_entrada" class="text-right"><strong><t t-esc="'%.3f' % grp['sub_entrada_qty']"/></strong></td>
                                        <td t-if="show_saida" class="text-right"><strong><t t-esc="'%.3f' % grp['sub_saida_qty']"/></strong></td>
                                        <td t-if="show_saldo" class="text-right"><strong><t t-esc="'%.3f' % (grp['sub_entrada_qty'] - grp['sub_saida_qty'])"/></strong></td>
                                        <td></td>
                                        <td t-if="show_entrada" class="text-right">
                                            <strong>
                                                <span t-esc="grp['sub_cost_entrada']"
                                                      t-options='{"widget": "monetary", "display_currency": filters["company_currency"]}'/>
                                            </strong>
                                        </td>
                                        <td t-if="show_saida" class="text-right">
                                            <strong>
                                                <span t-esc="grp['sub_cost_saida']"
                                                      t-options='{"widget": "monetary", "display_currency": filters["company_currency"]}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </t>

                                <tr class="table-secondary">
                                    <td colspan="3" class="text-right"><strong>TOTAL GERAL (<t t-esc="totals.get('product_count')"/> produtos):</strong></td>
                                    <td t-if="show_entrada" class="text-right"><strong><t t-esc="'%.3f' % totals.get('total_entrada_qty', 0)"/></strong></td>
                                    <td t-if="show_saida" class="text-right"><strong><t t-esc="'%.3f' % totals.get('total_saida_qty', 0)"/></strong></td>
                                    <td t-if="show_saldo" class="text-right"><strong><t t-esc="'%.3f' % (totals.get('total_entrada_qty', 0) - totals.get('total_saida_qty', 0))"/></strong></td>
                                    <td></td>
                                    <td t-if="show_entrada" class="text-right">
                                        <strong>
                                            <span t-esc="totals.get('total_cost_entrada', 0)"
                                                  t-options='{"widget": "monetary", "display_currency": filters["company_currency"]}'/>
                                        </strong>
                                    </td>
                                    <td t-if="show_saida" class="text-right">
                                        <strong>
                                            <span t-esc="totals.get('total_cost_saida', 0)"
                                                  t-options='{"widget": "monetary", "display_currency": filters["company_currency"]}'/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <p class="text-muted font-italic mt-2" style="font-size: 9px;">
                            Nota: Custo unitário utiliza o valor atual cadastrado no produto (standard_price),
                            não o custo histórico no momento da movimentação.
                        </p>
                    </t>
                </div>
            </t>
            </t>
        </t>
    </template>
</odoo>

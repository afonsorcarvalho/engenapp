<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_stock_movement_summary" model="ir.actions.report">
        <field name="name">Sumário de Movimentações</field>
        <field name="model">stock.movement.summary.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">afr_stock_reports.report_stock_movement_summary_template</field>
        <field name="report_file">afr_stock_reports.report_stock_movement_summary_template</field>
        <field name="print_report_name">'Sumario_Movimentacoes_%s_a_%s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="afr_stock_reports.paperformat_stock_report_landscape"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_expire_enrollments" model="ir.cron">
        <field name="name">WireGuard: Expirar Enrollments Pendentes</field>
        <field name="model_id" ref="model_wireguard_enrollment"/>
        <field name="state">code</field>
        <field name="code">model.expire_old()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="cron_purge_enroll_attempts" model="ir.cron">
        <field name="name">WireGuard: Limpar Tentativas de Enrollment</field>
        <field name="model_id" ref="model_wireguard_enroll_attempt"/>
        <field name="state">code</field>
        <field name="code">model.purge_old()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>

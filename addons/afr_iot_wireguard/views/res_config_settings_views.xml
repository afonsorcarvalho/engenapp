<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.wireguard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="WireGuard IoT" string="WireGuard IoT"
                     data-key="afr_iot_wireguard">
                    <h2>WireGuard IoT</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Daemon</span>
                                <div class="text-muted">
                                    Configurações de conexão com o daemon WireGuard no host.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label class="col-lg-4 o_light_label" for="wg_daemon_url">URL do Daemon</label>
                                        <field name="wg_daemon_url" class="col-lg-8"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-4 o_light_label" for="wg_daemon_secret">Chave Secreta</label>
                                        <field name="wg_daemon_secret" class="col-lg-8" password="True"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-4 o_light_label" for="wg_interface">Interface</label>
                                        <field name="wg_interface" class="col-lg-8"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Servidor VPN</span>
                                <div class="text-muted">
                                    Configurações entregues aos dispositivos ao ativar.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row">
                                        <label class="col-lg-4 o_light_label" for="wg_server_public_key">Chave Pública</label>
                                        <field name="wg_server_public_key" class="col-lg-8"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-4 o_light_label" for="wg_server_endpoint">Endpoint</label>
                                        <field name="wg_server_endpoint" class="col-lg-8" placeholder="vpn.empresa.com:51820"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-4 o_light_label" for="wg_client_allowed_ips">Allowed IPs</label>
                                        <field name="wg_client_allowed_ips" class="col-lg-8"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-4 o_light_label" for="wg_dns">DNS</label>
                                        <field name="wg_dns" class="col-lg-8" placeholder="10.8.0.1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

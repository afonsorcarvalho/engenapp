<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Página de confirmação de ativação -->
    <template id="activate_template" name="Ativar Dispositivo WireGuard">
        <t t-call="afr_iot_wireguard.activate_layout">
            <t t-set="title">Ativar Dispositivo</t>
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fa fa-wifi me-2"/>
                        Ativar Dispositivo WireGuard
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">Dispositivo</small>
                        <div class="fw-bold fs-5"><t t-esc="device.name"/></div>
                        <div class="text-muted small font-monospace"><t t-esc="device.device_hw_id"/></div>
                    </div>
                    <t t-if="device.partner_id">
                        <div class="mb-3">
                            <small class="text-muted">Cliente</small>
                            <div class="fw-bold"><t t-esc="device.partner_id.name"/></div>
                        </div>
                    </t>
                    <div class="mb-3">
                        <small class="text-muted">Código de Ativação</small>
                        <div class="font-monospace fs-4 fw-bold text-primary"><t t-esc="enrollment.code"/></div>
                    </div>
                    <div class="mb-4">
                        <small class="text-muted">Solicitado em</small>
                        <div><t t-esc="enrollment.create_date"/></div>
                        <small class="text-muted">Expira em</small>
                        <div><t t-esc="enrollment.expires_at"/></div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        Confirme que este dispositivo é legítimo antes de ativar.
                    </div>

                    <form method="post" action="/activate">
                        <input type="hidden" name="code" t-att-value="enrollment.code"/>
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="d-grid gap-2">
                            <button type="submit" name="action" value="confirm"
                                    class="btn btn-success btn-lg">
                                <i class="fa fa-check me-2"/>Confirmar Ativação
                            </button>
                            <button type="submit" name="action" value="cancel"
                                    class="btn btn-outline-secondary btn-lg">
                                <i class="fa fa-times me-2"/>Cancelar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Página de resultado (sucesso ou cancelamento) -->
    <template id="activate_success_template" name="Resultado da Ativação">
        <t t-call="afr_iot_wireguard.activate_layout">
            <t t-set="title">Resultado da Ativação</t>
            <div class="card shadow-sm">
                <div t-if="success" class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fa fa-check-circle me-2"/>Ativação Concluída</h5>
                </div>
                <div t-else="" class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fa fa-times-circle me-2"/>Cancelado</h5>
                </div>
                <div class="card-body text-center py-4">
                    <p class="fs-5"><t t-esc="message"/></p>
                    <t t-if="device">
                        <p class="text-muted"><t t-esc="device.name"/> (<t t-esc="device.device_hw_id"/>)</p>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- Página de erro -->
    <template id="activate_error_template" name="Erro de Ativação">
        <t t-call="afr_iot_wireguard.activate_layout">
            <t t-set="title">Erro</t>
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fa fa-exclamation-circle me-2"/>Erro</h5>
                </div>
                <div class="card-body text-center py-4">
                    <p class="fs-5 text-danger"><t t-esc="message"/></p>
                </div>
            </div>
        </t>
    </template>

    <!-- Layout base mobile-first -->
    <template id="activate_layout" name="Layout Base Ativação">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title><t t-esc="title or 'WireGuard'"/> — WireGuard IoT</title>
                <link rel="stylesheet" href="/web/static/lib/bootstrap/css/bootstrap.css"/>
                <style>
                    body { background: #f0f4f8; font-family: system-ui, sans-serif; }
                    .container { max-width: 480px; padding: 1.5rem; }
                    .card { border-radius: 1rem; overflow: hidden; }
                    .font-monospace { font-family: monospace; }
                </style>
            </head>
            <body>
                <div class="container mx-auto mt-4">
                    <div class="text-center mb-3">
                        <small class="text-muted">WireGuard IoT Enrollment</small>
                    </div>
                    <t t-raw="0"/>
                </div>
            </body>
        </html>
    </template>

</odoo>
